<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MapperPillow\MapperPillow.csproj" />
    <!-- Wire the generator directly so it runs on this project's call sites. -->
    <ProjectReference Include="..\..\src\MapperPillow.Generator\MapperPillow.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      UndefineProperties="PublishTrimmed;PublishAot;RuntimeIdentifier;SelfContained" />
  </ItemGroup>

  <!-- A NuGet consumer gets this automatically from the package's build\ folder;
       the sample references the project directly, so it imports it by hand. -->
  <Import Project="..\..\src\MapperPillow\build\MapperPillow.targets" />

</Project>
