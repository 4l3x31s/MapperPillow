<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Mirrors the library's targets so the net8.0 FeatureSwitchDefinition polyfill
         and the generated interceptors are exercised on every supported runtime. -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <!-- Runs the trim/AOT analyzers over the GENERATED interceptors, which live in
         this project rather than in the library. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MapperPillow\MapperPillow.csproj" />
    <!-- Wire the generator so interceptors are emitted for this project's call sites. -->
    <ProjectReference Include="..\..\src\MapperPillow.Generator\MapperPillow.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      UndefineProperties="PublishTrimmed;PublishAot;RuntimeIdentifier;SelfContained" />
  </ItemGroup>

  <!-- Consume the same targets the NuGet package ships (they opt this project into
       the interceptors namespace), so a regression there breaks the test suite
       instead of only surfacing for package consumers. -->
  <Import Project="..\..\src\MapperPillow\build\MapperPillow.targets" />

</Project>
