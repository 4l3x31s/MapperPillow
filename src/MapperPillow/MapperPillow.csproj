<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Turns on the trim/AOT analyzers so any reflection creeping back in is a
         build warning here, not a silent failure in a consumer's published app. -->
    <IsAotCompatible>true</IsAotCompatible>

  </PropertyGroup>

  <!-- ================================ package ================================ -->
  <PropertyGroup>
    <!-- Directory.Build.props opts every project out of packing; this is the one
         that ships. -->
    <IsPackable>true</IsPackable>

    <PackageId>MapperPillow</PackageId>
    <Version>1.0.0</Version>

    <!-- Pinned to the major version on purpose. NuGet resolves by <Version>, but
         the CLR binds by assembly identity: leaving this at the SDK default would
         make 1.0.1 a new identity, so anything that hard-binds (a strong-named
         consumer, a plugin host, a binding redirect) breaks on a patch release.
         Move these only when the major moves. -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>

    <Title>MapperPillow</Title>
    <Description>A comfortable, convention-first object mapper for .NET — compile-time and zero-ceremony. Properties that match by name map on their own; attributes cover the unusual cases. A Roslyn source generator plus C# interceptors emit the mapping code at build time, so there is no runtime reflection, no mapper instance to register, and no startup call. Trimming- and Native AOT-safe, and an easy migration from AutoMapper. MIT licensed.</Description>
    <PackageTags>mapper;object-mapper;mapping;dto;automapper;source-generator;roslyn;interceptors;aot;trimming;codegen</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>First stable release. See https://github.com/4l3x31s/MapperPillow/releases for the full notes.</PackageReleaseNotes>

    <!-- Ship a .snupkg to nuget.org's symbol server. Combined with SourceLink this
         is what lets a consumer step into MapperPillow instead of hitting a
         decompiled wall while debugging their own mapping. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Fails the pack when the package's public API is not consistent across the
         frameworks it multi-targets, and — once PackageValidationBaselineVersion
         is set to the previous release — when a new version breaks the API a
         published consumer already compiled against. -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <!-- The readme nuget.org renders as the package landing page. Its cross-document
       links are absolute so they resolve there as well as on GitHub. -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- The source generator ships inside this package as an analyzer. -->
  <ItemGroup>
    <ProjectReference Include="..\MapperPillow.Generator\MapperPillow.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      UndefineProperties="PublishTrimmed;PublishAot;RuntimeIdentifier;SelfContained" />
  </ItemGroup>

  <!-- Gives consumers <MapperPillowEnableReflectionFallback>. This must ship as a
       .targets, not a .props: NuGet imports build\*.props before the consuming
       project's body, so PublishTrimmed/PublishAot would not be set yet. -->
  <ItemGroup>
    <None Include="build\MapperPillow.targets" Pack="true" PackagePath="build\" />
  </ItemGroup>

  <!-- Ship the generator inside this package under analyzers\dotnet\cs, so a NuGet
       consumer gets compile-time interception. Without this the package is runtime
       reflection only — which trimmed and Native AOT builds refuse to run.
       The ProjectReference above uses ReferenceOutputAssembly="false", so the
       generator's path is not in @(ReferencePath); ask the project for it directly. -->
  <Target Name="_PackMapperPillowGenerator"
          BeforeTargets="_GetPackageFiles"
          Condition="'$(TargetFramework)' == ''">
    <!-- Build and path query are separate calls on purpose: asking for
         "Build;GetTargetPath" returns the assembly path from both targets, and the
         duplicate reaches the package as NU5118. -->
    <MSBuild Projects="..\MapperPillow.Generator\MapperPillow.Generator.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="PublishTrimmed;PublishAot;RuntimeIdentifier;SelfContained;TargetFramework" />

    <MSBuild Projects="..\MapperPillow.Generator\MapperPillow.Generator.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="PublishTrimmed;PublishAot;RuntimeIdentifier;SelfContained;TargetFramework">
      <Output TaskParameter="TargetOutputs" ItemName="_MapperPillowGeneratorAssembly" />
    </MSBuild>

    <Error Condition="'@(_MapperPillowGeneratorAssembly)' == ''"
           Text="Could not resolve the MapperPillow generator assembly; the package would ship without compile-time interception." />

    <ItemGroup>
      <None Include="@(_MapperPillowGeneratorAssembly)"
            Pack="true"
            PackagePath="analyzers\dotnet\cs"
            Visible="false" />
    </ItemGroup>
  </Target>

</Project>
